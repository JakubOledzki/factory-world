; Engine configuration file.

config_version=5

[application]

config/name="Factory World"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[autoload]

Net="*res://autoload/net.gd"
Game="*res://autoload/game.gd"
Touch="*res://autoload/touch.gd"
Tutorial="*res://autoload/tutorial.gd"
Online="*res://autoload/online.gd"
Settings="*res://autoload/settings.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[factory_world]

server_url="ws://localhost:5080/ws"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
