# Copy to .env on the server and fill in.
DOMAIN=gra.twojadomena.pl
POSTGRES_PASSWORD=zmien-mnie-na-dlugie-losowe-haslo
# Image version to run; "latest" follows the main branch.
TAG=latest

# Monitoring in Grafana Cloud (docs/monitoring.md): uncomment and fill in to start the alloy container.
# COMPOSE_PROFILES=monitoring
# GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-XX-prod-eu-west-2.grafana.net/api/prom/push
# GRAFANA_CLOUD_PROMETHEUS_USER=1234567
# GRAFANA_CLOUD_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
# GRAFANA_CLOUD_LOKI_USER=1234567
# GRAFANA_CLOUD_TOKEN=glc_...
