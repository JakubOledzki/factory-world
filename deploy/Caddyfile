# Serves the web build of the game and forwards /ws and /health to the game server.
# Caddy gets and renews the HTTPS certificate for $DOMAIN automatically.
{$DOMAIN} {
	encode zstd gzip

	handle /ws {
		reverse_proxy server:5080
	}

	handle /health {
		reverse_proxy server:5080
	}

	handle {
		root * /srv
		# The game files keep the same names in every release (index.pck, index.wasm),
		# so browsers must revalidate them or they keep running an old version.
		header Cache-Control "no-cache"
		file_server
	}
}
